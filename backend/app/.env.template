SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lost_and_found
SPRING_DATASOURCE_USERNAME=your-db-user
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_PROFILES_ACTIVE=dev

#HMAC is only to make local dev easier! (so everybody doesn't have to generate ES256 keypairs all the time.)
#For prod, use ES256!
JWT_HMAC_SECRET_KEY=replace-with-base64-encoded-256-bit-key
JWT_ES256_PRIVATE_KEY_PEM=replace-with-pem-private-key
JWT_ES256_PUBLIC_KEY_PEM=replace-with-pem-public-key

SUPPORT_EMAIL=support@example.com
APP_EMAIL_PASSWORD=your-gmail-app-password

# Docker Compose: local Postgres and pgAdmin passwords.
# POSTGRES_PASSWORD must equal SPRING_DATASOURCE_PASSWORD above.
# Run compose with: docker compose --env-file backend/app/.env ...
POSTGRES_PASSWORD=change-me
PGADMIN_DEFAULT_PASSWORD=change-me

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

DEV_HOSTNAME=http://localhost:5173
# Optional: frontend origin used in verification and reset email links (defaults to DEV_HOSTNAME).
# FRONTEND_URL=http://localhost:5173
PROD_HOSTNAME=https://your-frontend.example.com

GOOGLE_OAUTH2_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# Native iOS app (Capacitor)
NATIVE_ORIGINS=capacitor://localhost
# Web client id and iOS client id, comma-separated. Google ID tokens must be issued to one of these.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
# iOS bundle id(s), comma-separated. Sign in with Apple tokens must be issued to one of these.
APPLE_BUNDLE_IDS=edu.example.lostandfound
# Sign in with Apple revocation (optional). Your Apple Developer team id, the key id of a Sign in with Apple key,
# and that key's .p8 contents as one line with \n for line breaks. Keep the real key out of git.
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace-with-p8-contents\n-----END PRIVATE KEY-----
