# Copy to frontend/.env (git-ignored) and fill in. Vite only exposes variables that start with VITE_.
# Backend URL. Leave empty for local web dev (http://localhost:8080).
# The native iOS build needs the public HTTPS API here: the phone cannot reach your laptop's localhost.
VITE_API_URL=

# Google Maps JavaScript key. Restrict it by HTTP referrer, and add capacitor://localhost for the iOS app.
VITE_GOOGLE_MAPS_API_KEY=

# Native Google sign-in (Google Cloud OAuth clients).
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Native Sign in with Apple: the iOS bundle identifier (must match the Xcode target and APPLE_BUNDLE_IDS on the backend).
VITE_APPLE_CLIENT_ID=
